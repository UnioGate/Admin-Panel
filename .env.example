# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Admin allowlist — comma-separated `email|Display Name|Role`.
# Role is Owner, Admin or Support; name and role are presentation only, the
# email is what grants access. Keep both vars identical: the server check reads
# ADMIN_ALLOWLIST, the client guard reads the NEXT_PUBLIC_ copy (which ships in
# the browser bundle, so put nothing sensitive in it).
# An unset allowlist admits nobody. Restart the dev server after editing.
ADMIN_ALLOWLIST=owner@uniogate.com|Owner Name|Owner,ops@uniogate.com|Ops|Admin
NEXT_PUBLIC_ADMIN_ALLOWLIST=owner@uniogate.com|Owner Name|Owner,ops@uniogate.com|Ops|Admin

# Supabase (waitlist + contact messages)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
