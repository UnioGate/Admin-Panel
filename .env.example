# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The admin allowlist is NOT here — it lives in the `admins` table in Supabase
# and is edited from Settings. Run sql/admins.sql to create it; that migration
# also seeds the first Owner, which is the only way in before anyone exists.

# Supabase (admins, waitlist, contact messages, email)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com
# The API key can send as any address on the verified domain, so it is
# server-only. Never give it a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# From Resend → Webhooks, the `whsec_…` signing secret for the `email.received`
# endpoint pointing at /api/email/inbound. That signature is the only thing
# guarding the route — Resend has no admin session — so without this set the
# route refuses every request instead of accepting unsigned writes.
RESEND_WEBHOOK_SECRET=

# The verified sending domain, and the addresses the console may send as.
# Resend has no per-address setup — a verified domain permits any local part —
# so this list only exists to stop a typo going out as a real-looking address
# nobody reads. Bare names get @EMAIL_DOMAIN appended; full addresses pass
# through. Inbound mail to any other address on the domain is still captured.
EMAIL_DOMAIN=uniogate.com
EMAIL_MAILBOXES=support,hello,partners
